# =============================================================================
# 📋 Docker 环境变量配置模板
# 使用方法：复制此文件为 .env，然后填入你的配置
# ⚠️ 注意：.env 文件包含敏感信息，切勿提交到版本控制系统！
#
# Docker Compose 会自动读取同目录下的 .env 文件
# =============================================================================

# MySQL 8.4 容器（必填）。只在数据卷首次初始化时生效，之后改密码需手动 ALTER USER。
# 建议只用字母和数字、24 位以上（应用账号密码要写进 DATABASE_URL，特殊字符需百分号编码）
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_APP_PASSWORD=change_me_app
# 应用账号名（可选，默认 english_app）
# MYSQL_APP_USER=english_app

# DeepSeek 密钥等后端配置不在这里：容器中的后端读取 backend_fastapi/.env（env_file）。

# 容器中后端的覆盖项（可选，未设置时为下列生产默认值）
# BACKEND_OCR_MODE=docker
# BACKEND_AI_FALLBACK_ENABLED=false
# 用 flutter run -d chrome 连容器中的后端时设置，例如 http://localhost:5000,http://127.0.0.1:5000
# BACKEND_CORS_ALLOW_ORIGINS=
# BACKEND_LOG_LEVEL=INFO
