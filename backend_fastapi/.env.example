# =============================================================================
# 📋 后端环境变量配置模板
# 使用方法：复制此文件为 .env，然后填入你的配置
# ⚠️ 注意：.env 文件包含敏感信息，切勿提交到版本控制系统！
# =============================================================================

# DeepSeek API 配置（必填）
# 在 https://platform.deepseek.com/api_keys 获取你的 API Key
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com

# 数据库配置（MySQL 8.4 容器，见 docker/docker-compose.yml；主机端口 3307，不是 3306）
# 用户名与密码对应 docker/.env 中的 MYSQL_APP_USER / MYSQL_APP_PASSWORD；密码含特殊字符时需百分号编码
DATABASE_URL=mysql+asyncmy://english_app:change_me_app@127.0.0.1:3307/english_learning?charset=utf8mb4
# 测试库：只给 pytest 与 `alembic -x target=test` 使用，库名必须是 english_learning_test
TEST_DATABASE_URL=mysql+asyncmy://english_app:change_me_app@127.0.0.1:3307/english_learning_test?charset=utf8mb4

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true

# OCR 服务配置
# 本地开发模式：http://localhost:8866
# Docker 模式：http://english_ocr:8866
OCR_SERVICE_URL=http://localhost:8866
# OCR 模式（未设置时默认 docker）：
#   docker - 生产：OCR 不可用时返回 503
#   auto   - 本地开发：OCR 不可用时回落示例词，响应带 degraded/reason
#   mock   - 始终返回示例词（同样带 degraded）
OCR_MODE=docker

# AI 失败时是否回落示例故事（未设置时默认 false）：
#   false - 生产：AI 不可用、超时、返回异常时直接报错（502/503/504）
#   true  - 仅限本地开发：回落示例故事，响应带 degraded/reason；没有 API Key 时也能跑通流程
AI_FALLBACK_ENABLED=false

# 允许跨域访问的来源（CORS 白名单），逗号分隔；格式 http(s)://主机[:端口]，不带路径和结尾的 /，不支持 *。
# 未设置时为空：不允许任何跨域来源（生产环境 Web 由后端同源托管，移动端 App 不受 CORS 限制）。
# 本地 flutter run -d chrome --web-port 5000 时设为：
#   CORS_ALLOW_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
CORS_ALLOW_ORIGINS=
# FRONTEND_URL 已废弃（从未生效），请从 .env 中删除

# 账号
# 登录凭证有效期（天）
SESSION_TTL_DAYS=30
# 启动时与每 24 小时清理过期会话，以及超过 2 天的限流计数
SESSION_CLEANUP_ENABLED=true
# 接口文档 /docs、/redoc、/openapi.json：未设置时关闭（生产）；本地开发可设为 true
API_DOCS_ENABLED=false

# 防滥用限流（未设置时使用下列默认值）。窗口单位为秒，最长 86400（1 天），按 UTC 对齐：
# 按天的额度在 UTC 0 点（北京时间 8 点）重置。超限返回 429，带 Retry-After 头
RATE_LIMIT_ENABLED=true
# 识别、生成：按用户
RATE_LIMIT_OCR_PER_USER=60
RATE_LIMIT_OCR_WINDOW_SECONDS=86400
RATE_LIMIT_COMPOSE_PER_USER=30
RATE_LIMIT_COMPOSE_WINDOW_SECONDS=86400
# 登录、注册：按客户端 IP（只取连接地址，不信任 X-Forwarded-For）
RATE_LIMIT_LOGIN_PER_IP=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
RATE_LIMIT_REGISTER_PER_IP=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600

# 输入上限：词表超限返回 422；请求体超限返回 413
COMPOSE_MAX_WORDS=20
COMPOSE_MAX_WORD_LENGTH=40
# 上传图片（/ocr/recognize 整个请求体）10 MB；其他接口 1 MB
MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BYTES=1048576
HISTORY_MAX_PAGE_SIZE=50
