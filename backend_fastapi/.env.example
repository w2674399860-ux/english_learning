# =============================================================================
# 📋 后端环境变量配置模板
# 使用方法：复制此文件为 .env，然后填入你的配置
# ⚠️ 注意：.env 文件包含敏感信息，切勿提交到版本控制系统！
# =============================================================================

# DeepSeek API 配置（必填）
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com

# 数据库配置
DATABASE_URL=sqlite:///./data/english_learning.db

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8002
DEBUG=true

# OCR 服务配置
OCR_SERVICE_URL=http://localhost:8866
OCR_MODE=auto

# Flutter 前端地址（CORS）
FRONTEND_URL=http://localhost:3000
